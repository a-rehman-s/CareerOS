# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careeros?schema=public"

# Direct connection (for migrations — Supabase uses this to bypass pgBouncer)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/careeros?schema=public"

# ── Authentication ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here-generate-a-real-one"

# Auth URL (set explicitly in production)
AUTH_URL="http://localhost:3000"

# ── Supabase (optional — used for auth provider & storage) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ─────────────────────────────────────────────────────────────────────────
# OpenAI / Anthropic / Google API key for AI agent features
AI_API_KEY=


# AI provider: openai | anthropic | google
AI_PROVIDER=openai

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_BUCKET=careeros-documents

# ── Job Providers ──────────────────────────────────────────────────────────────
# API key for job source integration (e.g. Adzuna, LinkedIn, etc.)
JOB_PROVIDER_API_KEY=
JOB_PROVIDER_APP_ID=

# ── Application ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV=development
